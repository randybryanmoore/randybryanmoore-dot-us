{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "ableton": {
      "command": "uvx",
      "args": ["ableton-mcp"]
    },
    "openrouter": {
      "url": "https://mcp.openrouter.ai/mcp"
    }
  }
}

